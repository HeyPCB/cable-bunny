   "block": "merch_press_power",
   "as": "nose",
   "title": "Boop the nose: power while pressed, B5819W blocks back-feed",
   "nets": {
    "VSW": "VSW",
    "VTEST": "VTEST"
   }
  },
  {
   "block": "merch_usbc_test_source",
   "as": "src",
   "title": "Left foot: drives every line (150 ohm each)",
   "nets": {
    "VTEST": "VTEST"
   }
  },
